<Page x:Class="ekz.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главное меню" 
      Height="450" Width="800">

    <Grid Background="Azure" Margin="0,0,0,-82">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10">
            <TextBlock Text="ТРАНСПОРТНАЯ КОМПАНИЯ - ГЛАВНОЕ МЕНЮ" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Только ОСНОВНЫЕ кнопки -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="352">

            <Button x:Name="btnUsers" Content="Управление пользователями" 
                    Width="300" Height="50" Margin="10" FontSize="16"
                    Click="BtnUsers_Click" Background="#4CAF50" Foreground="White"/>

            <Button x:Name="btnCars" Content="Просмотр автомобилей" 
                    Width="300" Height="50" Margin="10" FontSize="16"
                    Click="BtnCars_Click" Background="#2196F3" Foreground="White"/>

            <!-- ТОЛЬКО ОДНА НОВАЯ КНОПКА (импорт) -->
            <Button x:Name="btnImport" Content="Импорт данных" 
                    Width="300" Height="50" Margin="10" FontSize="16"
                    Click="BtnImport_Click" Background="#009688" Foreground="White"/>

            <Button x:Name="btnExit" Content="Выход" 
                    Width="300" Height="45" Margin="10" FontSize="16"
                    Click="BtnExit_Click" Background="#F44336" Foreground="White"/>

            <Button x:Name="btnChangePassword" Content="Сменить пароль" 
        Width="300" Height="45" Margin="10" FontSize="16"
        Click="BtnChangePassword_Click" Background="#FF9800" Foreground="White"/>
        </StackPanel>

        <!-- Простой статус -->
        <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   x:Name="tbStatus" Text="Готово" Margin="10" Foreground="Gray"/>
    </Grid>
</Page>