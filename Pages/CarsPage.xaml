<Page x:Class="ekz.Pages.CarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Автомобили" 
      Height="690" Width="800">

    <Grid Background="">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14*"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,10">
            <Button x:Name="btnAddCar" Content="Добавить авто" Width="100" Margin="5" Click="BtnAddCar_Click"/>
            <Button x:Name="btnEditCar" Content="Изменить" Width="80" Margin="5" Click="BtnEditCar_Click"/>
            <Button x:Name="btnDeleteCar" Content="Удалить" Width="80" Margin="5" Click="BtnDeleteCar_Click"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="80" Margin="5" Click="BtnRefresh_Click"/>
            <Button x:Name="btnBack" Content="Назад" Width="80" Margin="5" Click="BtnBack_Click"/>
        </StackPanel>

        <!-- Список автомобилей -->
        <DataGrid x:Name="dgCars" Grid.Row="1" Margin="10,10,10,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True" Grid.RowSpan="2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Марка" Binding="{Binding marka}" Width="200"/>
                <DataGridTextColumn Header="Госномер" Binding="{Binding number}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус -->
        <StatusBar Grid.Row="2" Background="#F0F0F0" Margin="0,28,0,-15" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5">
            <StatusBar.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.094"/>
                    <TranslateTransform/>
                </TransformGroup>
            </StatusBar.RenderTransform>
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Готово" Height="26"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="tbCount" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>