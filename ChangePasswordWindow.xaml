<Window x:Class="ekz.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" 
        Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="СМЕНА ПАРОЛЯ" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Текущий пароль:" 
                       Margin="0,0,0,5" 
                       FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtCurrentPassword" 
                         Height="30" 
                         Margin="0,0,0,15"
                         PasswordChar="*"/>

            <TextBlock Text="Новый пароль:" 
                       Margin="0,0,0,5" 
                       FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtNewPassword" 
                         Height="30" 
                         Margin="0,0,0,15"
                         PasswordChar="*"
                         ToolTip="Пароль должен содержать минимум 6 символов"/>

            <TextBlock Text="Подтверждение пароля:" 
                       Margin="0,0,0,5" 
                       FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtConfirmPassword" 
                         Height="30" 
                         Margin="0,0,0,20"
                         PasswordChar="*"/>

            <!-- Валидационные сообщения -->
            <Border x:Name="borderError" 
                    Background="#FFEBEE" 
                    BorderBrush="#F44336" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtErrorMessage" 
                           Foreground="#D32F2F" 
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Правила пароля -->
            <Border Background="#E8F5E9" 
                    BorderBrush="#4CAF50" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Требования к паролю:" 
                               FontWeight="SemiBold" 
                               Foreground="#2E7D32" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="• Минимум 6 символов" 
                               Foreground="#555" 
                               FontSize="12"/>
                    <TextBlock Text="• Рекомендуется использовать цифры и буквы" 
                               Foreground="#555" 
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnChange" 
                    Content="Изменить пароль" 
                    Width="120" 
                    Height="35" 
                    Margin="5" 
                    Background="#4CAF50" 
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="BtnChange_Click"/>
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="80" 
                    Height="35" 
                    Margin="5" 
                    Background="#9E9E9E" 
                    Foreground="White"
                    Click="BtnCancel_Click"/>
            <!-- В ChangePasswordWindow.xaml добавьте кнопку: -->
            <Button Content="Тест БД" Height="25" Margin="0,5" Click="BtnTestDB_Click"/>
        </StackPanel>
    </Grid>
</Window>