<Window x:Class="ekz.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя" 
        Height="502" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Форма -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="ФИО:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Роль:" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbRole" Height="25" Margin="0,0,0,10">
                <ComboBoxItem>admin</ComboBoxItem>
                <ComboBoxItem>manager</ComboBoxItem>
                <ComboBoxItem>driver</ComboBoxItem>
                <ComboBoxItem>user</ComboBoxItem>
            </ComboBox>

            <CheckBox x:Name="chkBlocked" Content="Заблокирован" Margin="0,0,0,10"/>

            <TextBlock Text="Заказ:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtOrder" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пункт отправления:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDeparture" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пункт выдачи:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDestination" Height="25" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="5" 
                    Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="80" Margin="5" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>