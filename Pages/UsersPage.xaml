<Page x:Class="ekz.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи" 
      Height="500" Width="800">

    <Grid Margin="0,0,-232,-127">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Простые кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Добавить" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Изменить" Width="80" Margin="5" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Content="Обновить" Width="80" Margin="5" Click="BtnRefresh_Click"/>
            <Button Content="Назад" Width="80" Margin="5" Click="BtnBack_Click"/>
            <Button Content="Разблокировать" Width="100" Margin="5" Click="BtnUnblock_Click"/>
        </StackPanel>

        <!-- Простой DataGrid -->
        <DataGrid x:Name="dgUsers" Grid.Row="1" Margin="10" 
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"/>

        <!-- Статус -->
        <TextBlock Grid.Row="2" x:Name="tbStatus" Text="Готово" Margin="10"/>
    </Grid>
</Page>